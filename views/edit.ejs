<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>
تعديل المهمة
</title>


<style>

body{

    font-family: Arial, sans-serif;

    background:#f4f6f8;

    padding:20px;

}


.box{

    background:white;

    max-width:500px;

    margin:auto;

    padding:25px;

    border-radius:10px;

    box-shadow:0 0 10px #ccc;

}


h2{

    text-align:center;

}


label{

    display:block;

    margin-top:10px;

}


input, select{

    width:100%;

    padding:12px;

    margin-top:5px;

    box-sizing:border-box;

}


button{

    width:100%;

    padding:12px;

    margin-top:20px;

    background:#007bff;

    color:white;

    border:none;

    cursor:pointer;

    border-radius:5px;

}


a{

    display:block;

    text-align:center;

    margin-top:15px;

    text-decoration:none;

}



</style>


</head>


<body>


<div class="box">


<h2>
تعديل المهمة رقم <%= task.id %>
</h2>



<form method="POST" action="/update/<%= task.id %>">


<label>

رابط قائمة التشغيل

</label>


<input

type="text"

name="playlist_url"

value="<%= task.playlist_url %>"

required

>



<label>

وقت البدء

</label>


<input

type="time"

name="start_time"

value="<%= task.start_time %>"

required

>



<label>

مدة التشغيل بالثواني

</label>


<input

type="number"

name="duration"

value="<%= task.duration %>"

required

>



<label>

مدة الانتظار قبل الإعادة بالثواني

</label>


<input

type="number"

name="repeat_delay"

value="<%= task.repeat_delay %>"

required

>



<label>

الحالة

</label>


<select name="status">


<option 

value="running"

<%= task.status === "running" ? "selected" : "" %>>

تشغيل

</option>



<option 

value="stopped"

<%= task.status === "stopped" ? "selected" : "" %>>

إيقاف

</option>


</select>




<button>

حفظ التعديلات

</button>



</form>



<a href="/">

العودة للرئيسية

</a>



</div>



</body>


</html>