<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>
إضافة مهمة
</title>


<style>

body{

font-family:Arial;

background:#f4f6f8;

padding:20px;

}


.box{

background:white;

max-width:500px;

margin:auto;

padding:25px;

border-radius:10px;

box-shadow:0 0 10px #ccc;

}


input{

width:100%;

padding:12px;

margin:10px 0;

}


button{

background:#28a745;

color:white;

border:0;

padding:12px;

width:100%;

cursor:pointer;

}


a{

display:block;

margin-top:15px;

text-align:center;

}

</style>


</head>


<body>


<div class="box">


<h2>
إضافة قائمة تشغيل
</h2>


<form method="POST" action="/add">


<label>
رابط قائمة التشغيل
</label>


<input

type="text"

name="playlist_url"

placeholder="https://youtube.com/playlist..."

required

>



<label>
وقت البدء
</label>


<input

type="time"

name="start_time"

required

>



<label>
مدة التشغيل بالثواني
</label>


<input

type="number"

name="duration"

placeholder="3600"

required

>



<label>
مدة الانتظار قبل الإعادة بالثواني
</label>


<input

type="number"

name="repeat_delay"

value="5"

required

>



<button>

حفظ المهمة

</button>


</form>


<a href="/">

العودة

</a>


</div>


</body>

</html>